# Exemple documentaire pour pnpm dev (backends natifs, proxy Docker).
# En pratique, docker-compose.local.yml utilise routing.conf et envsubst :
#   LEGACY_UPSTREAM=host.docker.internal:4001 (retour arrière uniquement)
#   NESTJS_UPSTREAM=host.docker.internal:3001
#
# Démarrage : docker compose -f docker/docker-compose.local.yml up nginx-strangler
# Proxy accessible sur http://localhost:4000 ; le client utilise ce port pour /api.
# Aucun accès applicatif au legacy ni Swagger legacy dans la configuration normale.

upstream server-legacy {
    server host.docker.internal:4001;
}

upstream server-nestjs {
    server host.docker.internal:3001;
}

server {
    listen 8080;

    location = /api {
        return 404;
    }

    location /api/ {
        proxy_pass         http://server-nestjs;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_buffering    off;
        proxy_redirect     off;
    }

    location /swagger-ui-server-nestjs {
        proxy_pass         http://server-nestjs;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
